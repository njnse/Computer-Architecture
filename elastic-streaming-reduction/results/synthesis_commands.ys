# generic WIDTH=1 PIPE=1
design -reset;
read_verilog -sv rtl/stream_sum.sv; chparam -set WIDTH 1 -set PIPE 1 stream_sum; synth -top stream_sum; check -assert; tee -o results/generic_1_1.json stat -json; ltp -noff; write_verilog -noattr build/generic_1_1.v

