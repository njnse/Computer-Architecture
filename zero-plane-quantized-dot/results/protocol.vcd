$var reg 32 X t [31:0] $end
$var reg 32 Y v [31:0] $end
$upscope $end
$scope module dut $end
$var wire 1 * clk $end
$var wire 1 % in_ready $end
$var wire 8 Z in_tag [7:0] $end
$var wire 1 / in_valid $end
$var wire 32 [ in_w [31:0] $end
$var wire 32 \ in_x [31:0] $end
