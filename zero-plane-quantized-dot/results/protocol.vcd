$version
	Icarus Verilog
$end
$timescale
	1s
$end
$scope module check $end
$var wire 8 ! tag [7:0] $end
$var wire 19 " sum [18:0] $end
$var wire 1 # ov $end
$var wire 8 $ itag [7:0] $end
$var wire 1 % ir $end
$var parameter 32 & MODE $end
$var parameter 32 ' N $end
$var parameter 66 ( O $end
$var parameter 32 ) W $end
$var reg 1 * clk $end
$var reg 1024 + file_name [1023:0] $end
$var reg 1 , held $end
$var reg 19 - held_sum [18:0] $end
$var reg 8 . held_tag [7:0] $end
$var reg 1 / iv $end
$var reg 1 0 neg $end
$var reg 1 1 orr $end
