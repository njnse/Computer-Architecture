$var integer 32 O outstalls [31:0] $end
$var integer 32 P rc [31:0] $end
$var integer 32 Q resets [31:0] $end
$var integer 32 R seed [31:0] $end
$var integer 32 S simultaneous [31:0] $end
$var integer 32 T tail [31:0] $end
$var integer 32 U total_latency [31:0] $end
$var integer 32 V traffic [31:0] $end
$var integer 32 W zero_groups [31:0] $end
