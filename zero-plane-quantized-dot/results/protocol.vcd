$var wire 1 4 rst $end
$var wire 1 ] take $end
$var parameter 32 ^ MODE $end
$var parameter 32 _ N $end
$var parameter 66 ` O $end
$var parameter 32 a W $end
$var reg 19 b acc [18:0] $end
$var reg 1 c busy $end
$var reg 19 d extended_weight [18:0] $end
$var reg 1 e found $end
